<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add New Blog</title>

    <!-- Summernote CSS -->
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-lite.min.css" rel="stylesheet" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/summerNote.css" />

    <!-- jQuery (full version, Summernote ke liye required) -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js" crossorigin="anonymous"></script>

    <!-- Summernote JS -->
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-lite.min.js"></script>

    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Toastify CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />
  </head>
  <body>
    <div class="container">
      <h2>Add New Blog</h2>

    <form id="blogForm" action="/admin/blogs/add" method="POST" enctype="multipart/form-data">

  <!-- BASIC INFO -->
  <div class="section">
    <h3>Basic Information</h3>

    <div class="form-grid">

      <div class="field">
        <label>Blog Category</label>
        <select name="category_id" required>
          <option value="">Select Category</option>
          <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.category_id %>">
                <%= cat.category_name %>
              </option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <div class="field">
        <label>Status</label>
        <select name="status">
          <option value="draft">Draft</option>
          <option value="published">Published</option>
        </select>
      </div>

      <div class="field full">
        <label>Blog Title</label>
        <input type="text" name="title" required>
      </div>

      <div class="field">
        <label>Slug</label>
        <input type="text" name="slug">
      </div>

      <div class="field">
        <label>Author Name</label>
        <input type="text" name="author_name" value="Founder Code Team">
      </div>

      <div class="field full">
        <label>Short Description</label>
        <textarea name="short_description" rows="4"></textarea>
      </div>

    </div>
  </div>

  <!-- SEO -->
  <div class="section">
    <h3>SEO Settings</h3>

    <div class="form-grid">

      <div class="field full">
        <label>Meta Title</label>
        <input type="text" name="meta_title">
      </div>

      <div class="field full">
        <label>Meta Description</label>
        <textarea name="meta_description" rows="4"></textarea>
      </div>

      <div class="field full">
        <label>Image Alt Text</label>
        <input type="text" name="image_alt">
      </div>

    </div>
  </div>

  <!-- PUBLISHING -->
  <div class="section">
    <h3>Publishing</h3>

    <div class="form-grid">

      <div class="field">
        <label>Reading Time</label>
        <input type="number" name="reading_time" value="1" min="1">
      </div>

      <div class="field">
        <label>Published At</label>
        <input type="datetime-local" name="published_at">
      </div>

      <div class="field">
        <label>Featured Blog</label>
        <select name="is_featured">
          <option value="0">No</option>
          <option value="1">Yes</option>
        </select>
      </div>

      <div class="field">
        <label>Blog Image</label>
        <input type="file" name="image">
      </div>

    </div>
  </div>

  <!-- CONTENT -->
  <div class="section">
    <h3>Blog Content</h3>

    <textarea id="summernote" name="content"></textarea>
  </div>

  <button type="submit" class="submit-btn">
    <i class="fa fa-save"></i>
    Publish Blog
  </button>

</form>
    </div>

    <!-- Summernote Initialization -->
    <script>
      $(document).ready(function () {
        $('#summernote').summernote({
          placeholder: 'Write your blog content here...',
          tabsize: 2,
          height: 300,
          toolbar: [
            ['style', ['style']],
            ['font', ['bold', 'underline', 'italic', 'clear', 'fontsize']],
            ['fontname', ['fontname']],
            ['color', ['color']],
            ['para', ['ul', 'ol', 'paragraph']],
            ['table', ['table']],
            ['insert', ['link', 'picture', 'video']],
            ['view', ['fullscreen', 'codeview', 'help']],
          ],
          callbacks: {
            onImageUpload: function (files) {
              for (let i = 0; i < files.length; i++) {
                let reader = new FileReader();
                reader.onload = function (e) {
                  $('#summernote').summernote('insertImage', e.target.result);
                };
                reader.readAsDataURL(files[i]);
              }
            },
          },
        });
      });
    </script>

    <!-- Toastify JS -->
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

    <!-- Toast on Form Submit -->
    <script>
      const blogForm = document.getElementById('blogForm');

      blogForm.addEventListener('submit', function (e) {
        e.preventDefault();

        Toastify({
          text: '✅ Blog added successfully!',
          duration: 2000,
          gravity: 'top',
          position: 'right',
          close: true,
          stopOnFocus: true,
          style: {
            background: '#16a34a', // green
            borderRadius: '10px',
            fontWeight: '600',
          },
        }).showToast();

        setTimeout(() => {
          blogForm.submit(); // form submit after toast
        }, 2000);
      });
    </script>

  		<script>
		document.addEventListener('DOMContentLoaded', () => {
		  const titleInput = document.querySelector('[name="title"]');
		  const slugInput = document.querySelector('[name="slug"]');
		  const metaTitleInput = document.querySelector('[name="meta_title"]');

		  let slugEdited = false;
		  let metaEdited = false;

		  slugInput.addEventListener('input', () => {
			slugEdited = true;
		  });

		  metaTitleInput.addEventListener('input', () => {
			metaEdited = true;
		  });

		  titleInput.addEventListener('input', () => {
			if (!slugEdited) {
			  slugInput.value = titleInput.value
				.toLowerCase()
				.replace(/[^a-z0-9]+/g, '-')
				.replace(/^-+|-+$/g, '');
			}

			if (!metaEdited) {
			  metaTitleInput.value = titleInput.value;
			}
		  });
		});
		</script>
    <!-- Back Button -->
    <a href="/admin/dashboard" class="btn-home"> <i class="fa fa-arrow-left"></i> Back </a>
  </body>
</html>
