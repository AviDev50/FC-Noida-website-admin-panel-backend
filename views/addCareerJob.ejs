<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Add New Job</title>

  <!-- Admin CSS -->
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="/css/addCareerForm.css" />

  <!-- Toastify CSS -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css"
  />
</head>

<body>

  <!-- ===== SIDEBAR ===== -->
  <%- include('partials/sidebar') %>

 
 <!-- ===== MAIN CONTENT ===== -->
<div class="career-page">

  <div class="career-header">
    <h2>Add New Job</h2>
    <p>Add a new job to your career portal.</p>
  </div>

  <div class="career-card">
    <form
      id="careerForm"
      action="/admin/career/add"
      method="POST"
      class="career-form"
    >

      <label>Job Title</label>
      <input type="text" name="job_title" placeholder="Enter job title" required />

      <label>Location</label>
      <input type="text" name="location" placeholder="Enter job location" required />

      <label>Job Type</label>
      <input type="text" name="job_type" placeholder="Full Time / Part Time" required />

      <label>Description</label>
      <textarea
        name="job_description"
        rows="5"
        placeholder="Enter job description"
        required
      ></textarea>

      <button type="submit">Add Job</button>
    </form>
  </div>

  <a href="/admin/career" class="career-back">
    ← Back to Job List
  </a>

</div>

  <!-- Toastify JS -->
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

  <script>
    const form = document.getElementById("careerForm");

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      Toastify({
        text: "✅ Job added successfully!",
        duration: 2000,
        gravity: "top",
        position: "right",
        close: true,
        stopOnFocus: true,
        style: {
          background: "#16a34a",
          borderRadius: "10px",
          fontWeight: "600"
        }
      }).showToast();

      setTimeout(() => {
        form.submit();
      }, 2000);
    });
  </script>

</body>
</html>
