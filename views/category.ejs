<%- include('partials/sidebar') %>

<link rel="stylesheet" href="/css/category.css">
<link rel="stylesheet" href="/css/admin.css">
<link rel="stylesheet" href="/css/deleteModal.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="main-content">
  <!-- HEADER -->
  <h2 class="text">Category Management</h2>
  <p class="subtitle">Manage all your blog categories. You can edit or delete categories easily from here.</p>

  <!-- ADD NEW CATEGORY BUTTON -->
  <a href="/admin/category/addForm" class="btn add-btn">
    <i class="fa fa-plus"></i> Add New Category
  </a>

  <!-- TABLE -->
  <div class="table-wrapper">
    <table class="category-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Category Name</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if(category && category.length > 0){ %>
          <% category.forEach(cat => { %>
            <tr>
              <td><%= cat.category_id %></td>
              <td><%= cat.category_name %></td>
              <td class="action-buttons">
                <!-- <a href="/admin/category/edit/<%= cat.category_id %>" class="btn edit-btn">
                  <i class="fas fa-edit"></i> Edit
                </a> -->
                <button class="btn delete-btn" onclick="openDeleteModal('<%= cat.category_id %>')">
                  <i class="fas fa-trash-alt"></i> Delete
                </button>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="3" class="no-data">No categories found</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- BACK TO DASHBOARD BUTTON -->
  <a href="/admin/dashboard" class="btn-home">
    <i class="fa fa-arrow-left"></i> Back
  </a>
</div>

<!-- DELETE MODAL -->
<div id="deleteModal" class="delete-modal">
  <p>Are you sure you want to delete this category?</p>
  <div class="modal-buttons">
    <button class="btn btn-confirm" id="confirmDelete">Delete</button>
    <button class="btn btn-cancel" onclick="closeDeleteModal()">Cancel</button>
  </div>
</div>

<!-- JS -->
<script>
  // DELETE MODAL LOGIC
  let deleteId = null;

  function openDeleteModal(id) {
    deleteId = id;
    document.getElementById("deleteModal").style.display = "flex";
  }

  function closeDeleteModal() {
    deleteId = null;
    document.getElementById("deleteModal").style.display = "none";
  }

  document.getElementById("confirmDelete").addEventListener("click", function () {
    if (deleteId !== null) {
      window.location.href = `/admin/category/delete/${deleteId}`;
    }
  });
</script>
