  <%- include('partials/sidebar') %>

  <!DOCTYPE html>
  <html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Career Job</title>


    <!-- Toastify CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />

    <!-- Custom CSS -->
  
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/editCareer.css">


    

    <!-- Toastify JS -->
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  </head>
  <body>

  <div class="container">
    <h2>Edit Career Job</h2>

    
    <form id="careerForm" action="/admin/career/edit/<%= career.id %>" method="POST">

      <label>Job Title</label>
      <input type="text" name="job_title" value="<%= career.job_title %>" required />

      <label>Location</label>
      <input type="text" name="location" value="<%= career.location %>" required />

      <label>Job Type</label>
      <select name="job_type" required>
        <option value="Full Time" <%= career.job_type === 'Full Time' ? 'selected' : '' %>>Full Time</option>
        <option value="Part Time" <%= career.job_type === 'Part Time' ? 'selected' : '' %>>Part Time</option>
      </select>

      <label>Job Description</label>
      <textarea id="summernote" name="job_description"><%- career.job_description %></textarea>

      <button type="button" id="updateCareerBtn">
        <i class="fa fa-save"></i> Update Career
      </button>
    </form>

    <a href="/admin/career" class="btn-home">
      <i class="fa fa-arrow-left"></i> Back
    </a>
  </div>

  <!-- Summernote Init -->
  <script>
    $(document).ready(function() {
      $('#summernote').summernote({
        height: 250
      });
    });
  </script>

  <!-- Toast + Submit -->
  <script>
    const form = document.getElementById("careerForm");
    const btn = document.getElementById("updateCareerBtn");

    btn.addEventListener("click", function () {
      Toastify({
        text: "Career updated successfully",
        duration: 2000,
        gravity: "top",
        position: "right",
        style: {
          background: "#16a34a",
          borderRadius: "10px",
          fontWeight: "600"
        }
      }).showToast();

      setTimeout(() => {
        form.submit();
      }, 1500);
    });
  </script>

  </body>
  </html>
