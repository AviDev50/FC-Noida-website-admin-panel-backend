<%- include('partials/sidebar') %>

<link rel="stylesheet" href="/css/employees.css" />
<link rel="stylesheet" href="/css/admin.css" />
<link rel="stylesheet" href="/css/deleteModal.css" />

<div class="page-wrapper">
  <!-- ================= HEADER ================= -->
  <div class="header">
    <div>
      <h2>Employees</h2>
      <p>View and manage all employee profiles</p>
    </div>

    <!-- ADD EMPLOYEE BUTTON -->
    <a href="/admin/employees/add" class="btn-add">
      Add Employee
    </a>
  </div>

  <!-- ================= EMPLOYEE TABLE ================= -->
  <div class="table-wrapper">
    <% if (employees && employees.length > 0) { %>
    <table class="employee-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Profile</th>
          <th>Name</th>
          <th>Role</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% employees.forEach((emp, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td>
            <img src="/uploads/<%= emp.image %>" class="table-profile-img" />
          </td>
          <td><%= emp.name %></td>
          <td><span class="role-badge"><%= emp.profile %></span></td>
          <td>
            <button
              class="btn-delete"
              onclick="openDeleteModal('<%= emp.id %>')"
            >
              <i class="fa fa-trash"></i>
            </button>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } else { %>
    <p class="no-data">No employees found</p>
    <% } %>
  </div>

  <!-- BACK TO DASHBOARD BUTTON -->
  <a href="/admin/dashboard" class="btn-home">
    <i class="fa fa-arrow-left"></i> Back
  </a>
</div>

<!-- DELETE MODAL -->
<div id="deleteModal" class="delete-modal">
  <p>Are you sure you want to delete this employee?</p>
  <div class="modal-buttons">
    <button class="btn btn-confirm" id="confirmDelete">Delete</button>
    <button class="btn btn-cancel" onclick="closeDeleteModal()">Cancel</button>
  </div>
</div>

<!-- JS -->
<script>
  let deleteId = null;

  function openDeleteModal(id) {
    deleteId = id;
    document.getElementById("deleteModal").style.display = "flex";
  }

  function closeDeleteModal() {
    deleteId = null;
    document.getElementById("deleteModal").style.display = "none";
  }

  document.getElementById("confirmDelete").addEventListener("click", function () {
    if (deleteId !== null) {
      window.location.href = `/admin/employees/delete/${deleteId}`;
    }
  });
</script>
