<%- include('partials/sidebar') %>

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  crossorigin="anonymous"
/>
<link rel="stylesheet" href="/css/admin.css" />
<link rel="stylesheet" href="/css/enquiry.css" />
<link rel="stylesheet" href="/css/deleteModal.css" />

<div class="page-wrapper">
  <div class="blog-header">
    <h1><i class="fa-solid fa-envelope"></i> Enquiries Dashboard</h1>
    <p>Welcome Admin! Manage all enquiries from here.</p>
  </div>

  <% if (enquiries && enquiries.length > 0) { %>
  <div class="table-responsive">
    <table class="enquiry-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Subject</th>
          <th>Message</th>
          <th>Date</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% enquiries.forEach((enquiry, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><i class="fa-solid fa-user"></i> <%= enquiry.name %></td>
          <td><i class="fa-solid fa-envelope"></i> <%= enquiry.email %></td>
          <td><i class="fa-solid fa-phone"></i> <%= enquiry.phone %></td>
          <td><i class="fa-solid fa-tag"></i> <%= enquiry.subject %></td>

          <td class="message-cell">
            <button
              class="btn-view"
              data-message="<%= enquiry.message %>"
              onclick="openMessage(this)"
            >
              <i class="fa-solid fa-eye"></i> View
            </button>
          </td>

          <td>
            <i class="fa-solid fa-calendar-days"></i>
            <%= new Date(enquiry.created_at).toLocaleDateString() %>
          </td>

          <td class="action-cell">
            <button
              class="btn-delete"
              onclick="openDeleteModal('<%= enquiry.id %>')"
            >
              <i class="fa-solid fa-trash"></i>
            </button>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <p class="no-data">No enquiries found</p>
  <% } %>

  <a href="/admin/dashboard" class="btn-home">
    <i class="fa fa-arrow-left"></i> Back to Dashboard
  </a>
</div>

<!-- MESSAGE MODAL -->
<div id="messageModal" class="modal">
  <div class="modal-content">
    <span class="close" onclick="closeMessage()">&times;</span>
    <h3><i class="fa-solid fa-envelope-open-text"></i> Enquiry Message</h3>
    <div id="fullMessage"></div>
  </div>
</div>

<!-- DELETE MODAL -->
<div id="deleteModal" class="delete-modal">
  <p>Are you sure you want to delete this enquiry?</p>
  <div class="modal-buttons">
    <button class="btn btn-confirm" id="confirmDelete">Delete</button>
    <button class="btn btn-cancel" onclick="closeDeleteModal()">Cancel</button>
  </div>
</div>

<!-- JS -->
<script>
  // MESSAGE MODAL
  function openMessage(btn) {
    const message = btn.getAttribute("data-message");
    document.getElementById("fullMessage").innerText = message;
    document.getElementById("messageModal").style.display = "block";
  }

  function closeMessage() {
    document.getElementById("messageModal").style.display = "none";
  }

  window.onclick = function (event) {
    const messageModal = document.getElementById("messageModal");
    if (event.target === messageModal) {
      messageModal.style.display = "none";
    }
  };

  // DELETE MODAL
  let deleteId = null;

  function openDeleteModal(id) {
    deleteId = id;
    document.getElementById("deleteModal").style.display = "flex";
  }

  function closeDeleteModal() {
    deleteId = null;
    document.getElementById("deleteModal").style.display = "none";
  }

  document.getElementById("confirmDelete").addEventListener("click", function () {
    if (deleteId !== null) {
      window.location.href = `/admin/enquiries/delete/${deleteId}`;
    }
  });
</script>
