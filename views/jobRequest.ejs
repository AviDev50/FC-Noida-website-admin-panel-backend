<%- include('partials/sidebar') %>

<link rel="stylesheet" href="/css/admin.css" />
<link rel="stylesheet" href="/css/jobRequest.css" />

<div class="page-wrapper">
  <!-- HEADER -->
  <div class="header">
    <h2>Job Requests</h2>
    <p>Manage job applications</p>
  </div>

  <!-- TABLE -->
  <div class="table-wrapper">
    <table class="employee-table">
    <thead>
  <tr>
    <th>Job Name</th>
    <th>Full Name</th>
    <th>Email</th>
    <th>Phone</th>
    <th>Resume</th>
    <th>Created At</th>
    <th>Action</th>
  </tr>
</thead>


<tbody>
  <% if (!requests || requests.length === 0) { %>
    <tr>
      <td colspan="7" style="text-align:center; padding:20px;">
        No job requests found
      </td>
    </tr>
  <% } else { %>
    <% requests.forEach(function(job) { %>
      <tr>
        <!-- JOB TITLE -->
        <td>
          <strong><%= job.job_title %></strong>
        </td>

        <td><%= job.full_name %></td>
        <td><%= job.email %></td>
        <td><%= job.phone %></td>

        <td>
          <% if (job.resume) { %>
            <a href="/uploads/<%= job.resume %>" target="_blank" class="btn-view">
              View
            </a>
          <% } else { %>
            N/A
          <% } %>
        </td>

        <td>
          <%= new Date(job.created_at).toLocaleDateString() %>
        </td>

        <td>
          <a href="javascript:void(0);" 
             class="btn-delete" 
             onclick="showDeleteToast('<%= job.job_request_id %>')">
            Delete
          </a>
        </td>
      </tr>
    <% }) %>
  <% } %>
</tbody>




      
    </table>
  </div>
</div>

<!-- DELETE TOAST POPUP -->
<div id="deleteToast" class="toast-popup" style="display:none;">
  <p>Are you sure you want to delete this request?</p>
  <div class="toast-actions">
    <button onclick="closeDeleteToast()">Cancel</button>
    <a id="confirmDeleteBtn" class="btn-confirm">Yes, Delete</a>
  </div>
</div>

<script>
  function showDeleteToast(id) {
    const toast = document.getElementById("deleteToast");
    toast.style.display = "flex";
    document.getElementById("confirmDeleteBtn").href = "/admin/jobRequest/delete/" + id;
  }

  function closeDeleteToast() {
    document.getElementById("deleteToast").style.display = "none";
  }
</script>
